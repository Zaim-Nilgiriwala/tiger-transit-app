{
  "expo": {
    "name": "Tiger Transit",
    "slug": "tiger-transit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C2340"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.auburn.tigertransit",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Tiger Transit needs your location to show nearby stops and routes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C2340"
      },
      "package": "com.auburn.tigertransit",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Tiger Transit to use your location to show nearby stops."
        }
      ]
    ]
  }
}
